# ---- Database ----
DATABASE_URL="sqlserver://localhost;database=mwmsys_local;integratedSecurity=true;trustServerCertificate=true"

# ---- Auth ----
JWT_SECRET=
PORT=3000

# ---- OpenAI (chatbot) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- SMTP (email OTP, Batch C) ----
# If any of SMTP_HOST / SMTP_USER / SMTP_PASS is blank, OTPs are logged to the
# server console instead of being emailed. See emailService.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MWMS <no-reply@example.com>"

# ---- Stripe (subscriptions, Batch D) ----
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price IDs for each plan. The Free plan has no checkout step — leave blank or unset.
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Legacy aliases accepted by subscriptionRoutes.ts — set whichever set your team uses.
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=
# Post-checkout redirect URLs (optional — origin is used as fallback).
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Comma-separated whitelist of hostnames allowed to receive the /stripe/return
# redirect. Leave blank to allow any http/https/exp URL.
STRIPE_RETURN_ALLOWED_HOSTS=
