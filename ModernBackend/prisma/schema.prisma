generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tbl_Agent {
  ID                      Int       @default(autoincrement())
  User_Id                 String    @db.VarChar(100)
  Agent_Name              String    @db.VarChar(100)
  Agent_Organization_Name String    @db.VarChar(100)
  Agent_IC_Passport       String    @db.VarChar(100)
  Agent_EmailID           String    @db.VarChar(100)
  Agent_Department        Int
  Agent_Country           Int
  Agent_ContactNumber     String    @db.VarChar(50)
  Created_By              String?   @db.VarChar(50)
  Created_On              DateTime?
  Agent_CountryCode       String?   @db.VarChar(10)

  @@id([User_Id, Agent_EmailID], map: "PK_Tbl_Agent")
}

model Tbl_Branch {
  ID               Int       @id(map: "PK_Branch") @default(autoincrement())
  Branch_Name      String    @db.VarChar(50)
  Branch_ShortName String    @db.VarChar(10)
  Branch_Status    Int
  Created_By       String?   @db.VarChar(50)
  Created_On       DateTime?
}

model Tbl_City {
  ID             Int       @default(autoincrement())
  Country_ID     Int
  State_ID       Int
  City_Name      String    @db.VarChar(50)
  City_ShortName String?   @db.VarChar(10)
  City_Status    Int
  Created_By     String?   @db.VarChar(50)
  Created_On     DateTime?

  @@id([ID, Country_ID, State_ID], map: "PK_City")
}

model Tbl_Country {
  ID                Int       @unique(map: "NonClusteredIndex_20250122_133511") @default(autoincrement())
  Country_Name      String    @db.VarChar(50)
  Country_ShortName String?   @db.VarChar(10)
  Country_Status    Int
  Created_By        String?   @db.VarChar(50)
  Created_On        DateTime?
  Country_Flag      Bytes?
  CountryCode       String?   @db.VarChar(10)
  FlagPath          String?   @db.VarChar(255)
}

model Tbl_Department {
  ID                Int       @id(map: "PK_Department") @default(autoincrement())
  Department_Name   String    @db.VarChar(50)
  Department_Status Int
  Created_By        String?   @db.VarChar(50)
  Created_On        DateTime?
}

model Tbl_Employer {
  ID                           Int       @default(autoincrement())
  User_Id                      String    @db.VarChar(100)
  Employer_Name                String    @db.VarChar(100)
  Employer_Address             String    @db.VarChar(500)
  Employer_ContactPerson       String    @db.VarChar(100)
  Employer_ContactPerson_IC    String?   @db.VarChar(50)
  Employer_ContactPerson_Email String?   @db.VarChar(100)
  Employer_ContactPerson_Phone String?   @db.VarChar(20)
  Employer_Position            String    @db.VarChar(100)
  Employer_EmailID             String    @db.VarChar(100)
  Employer_OfficeNumber        String?   @db.VarChar(20)
  Employer_CompanyPhone        String?   @db.VarChar(20)
  Employer_SSM_ROC_ROB_Number  String?   @db.VarChar(100)
  Employer_SSM_Number          String?   @db.VarChar(100)
  Employer_Sector              Int?
  Employer_SubSector           Int?
  Employer_PIC_MobileNumber    String    @db.VarChar(20)
  Employer_Description         String?   @db.VarChar(500)
  Employer_HFW                 Int?
  Employer_LFW                 Int?
  Employer_FWC_                String?   @map("Employer_FWC ") @db.VarChar(500)
  Created_By                   String?   @db.VarChar(50)
  Created_On                   DateTime?
  CountryCode                  String?   @db.VarChar(10)

  @@id([User_Id, Employer_EmailID], map: "PK_Tbl_Employer")
}

model Tbl_Subscription {
  id        Int      @id(map: "PK_Tbl_Subscription") @default(autoincrement())
  entityId  String   @db.VarChar(100)
  planType  String   @db.VarChar(20)
  status    String   @db.VarChar(20)
  startDate DateTime
  endDate   DateTime
}

model Tbl_Attendance {
  id          Int       @id(map: "PK_Tbl_Attendance") @default(autoincrement())
  workerId    String    @db.VarChar(100)
  checkIn     DateTime?
  checkOut    DateTime?
  lat         Decimal?  @db.Decimal(10, 7)
  lng         Decimal?  @db.Decimal(10, 7)
  photoUrl    String?   @db.VarChar(500)
  employerId  String?   @db.VarChar(100)
  status      String?   @db.VarChar(20)
  hoursWorked Decimal?  @db.Decimal(5, 2)
  clockOutLat Decimal?  @db.Decimal(10, 7)
  clockOutLng Decimal?  @db.Decimal(10, 7)
}

model Tbl_Leave {
  id        Int      @id(map: "PK_Tbl_Leave") @default(autoincrement())
  workerId  String   @db.VarChar(100)
  leaveType String   @db.VarChar(50)
  startDate DateTime
  endDate   DateTime
  status    String   @db.VarChar(20)
}

model Tbl_Payroll {
  id         Int      @id(map: "PK_Tbl_Payroll") @default(autoincrement())
  workerId   String   @db.VarChar(100)
