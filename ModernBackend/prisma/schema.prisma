  Employer_PIC_MobileNumber String    @db.VarChar(20)
  Created_By                String?   @db.VarChar(50)
  Created_On                DateTime?

  @@id([User_Id, Employer_EmailID], map: "PK_Tbl_EmployerIndividual")
}

model Tbl_Insurance {
