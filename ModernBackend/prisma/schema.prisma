  year       Int
  amount     Decimal  @db.Decimal(18, 2)
  voucherUrl String?  @db.VarChar(500)
  isPaid     Boolean  @default(false)
}

model Tbl_EmployerIndividual {
  ID                        Int       @default(autoincrement())
  User_Id                   String    @db.VarChar(100)
  Employer_Name             String    @db.VarChar(100)
  Employer_Address          String    @db.VarChar(500)
  Employer_ContactPerson    String    @db.VarChar(100)
