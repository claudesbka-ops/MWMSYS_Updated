{
  "rewrites": [
    {
      "source": "/socket.io/(.*)",
      "destination": "https://mwmsysmaster-production.up.railway.app/socket.io/$1"
    },
    {
      "source": "/Api/token",
      "destination": "https://mwmsysmaster-production.up.railway.app/auth/Api/token"
    },
    {
      "source": "/Api/(.*)",
      "destination": "https://mwmsysmaster-production.up.railway.app/Api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://mwmsysmaster-production.up.railway.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://mwmsysmaster-production.up.railway.app/auth/$1"
    },
    {
      "source": "/signup",
      "destination": "https://mwmsysmaster-production.up.railway.app/signup"
    },
    {
      "source": "/login",
      "destination": "https://mwmsysmaster-production.up.railway.app/auth/login"
    },
    {
      "source": "/logout",
      "destination": "https://mwmsysmaster-production.up.railway.app/logout"
    },
    {
      "source": "/refresh-token",
      "destination": "https://mwmsysmaster-production.up.railway.app/refresh-token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "app/api/*.js": {
      "maxDuration": 30
    }
  }
}
