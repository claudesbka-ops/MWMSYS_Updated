# Copy this file to .env and fill in values. Restart `npm run dev` after changes.

# URL of the ModernBackend API (required).
VITE_API_BASE_URL=http://localhost:3000

# Google Maps JavaScript API key (required for the Live Map page).
# Create a key in Google Cloud Console → APIs & Services → Credentials.
# Enable: Maps JavaScript API. Restrict the key to your domain / localhost.
VITE_GOOGLE_MAPS_API_KEY=
