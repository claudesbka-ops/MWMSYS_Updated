# Mobile app runtime config (read by Expo as process.env.EXPO_PUBLIC_*)
# Copy to .env and adjust per environment.

# Local dev (physical device on same LAN needs your machine's LAN IP, not localhost)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Staging / Production (MWMSYS Plesk)
# EXPO_PUBLIC_API_BASE_URL=http://173.233.72.39:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
